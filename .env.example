# AlphaTest Environment Variables Template
# Copy this file to .env for local development or set these in your cloud environment

# Environment (development or production)
ENV=production

# Server Port (automatically set by Cloud Run)
PORT=8080

# Security - IMPORTANT: Change this in production!
SECRET_KEY=your-very-secret-random-key-here-change-this

# CORS Settings
# For production, set to your frontend domain(s), comma-separated
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# Anthropic API Key (required for AI testing features)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Claude Model (optional, defaults to claude-sonnet-4)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GCP Configuration (for Cloud Storage - optional)
# If using Cloud Storage for persistent data/reports
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=alphatest-data
GCS_REPORTS_BUCKET=alphatest-reports

# Database (optional - for future multi-user support)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session Configuration
SESSION_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO
